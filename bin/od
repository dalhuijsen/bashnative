#!/bin/bash
# bashnative/od - dump files in octal and other formats

main () {
   if [[ "$1" == "--help" ]] || [[ "$1" == "-h" ]]; then
      echo "Usage: od [FILE]"
      echo "Write an unambiguous octal representation of FILE to stdout."
      exit 0
   fi

   local OFFSET=0

   while IFS= read -r -N 1 CHAR; do
      if (( OFFSET % 16 == 0 )); then
         (( OFFSET > 0 )) && echo
         printf "%07o" "$OFFSET"
      fi
      printf " %03o" "'$CHAR"
      (( OFFSET++ ))
   done < "${1:-/dev/stdin}"

   echo
   printf "%07o\n" "$OFFSET"
}

main "$@"

#!/bin/bash
# bashnative/sha512sum - compute SHA512 message digest

main () {
   [[ "$1" == "--help" ]] && { echo "Usage: sha512sum [FILE]..."; exit 0; }

   for FILE in "${@:--}"; do
      if type sha512sum >/dev/null 2>&1; then
         command sha512sum "$FILE"
      elif type shasum >/dev/null 2>&1; then
         shasum -a 512 "$FILE"
      elif type openssl >/dev/null 2>&1; then
         local OUT="$(openssl sha512 "$FILE" 2>/dev/null)"
         OUT="${OUT##* }"
         echo "${OUT}  $FILE"
      else
         echo "sha512sum: no sha512 tool available" >&2
         exit 1
      fi
   done
}

main "$@"

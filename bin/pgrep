#!/bin/bash
# bashnative/pgrep - look up processes based on name pattern
# Walks /proc (Linux only)

if [[ -z "$1" ]] || [[ "$1" == "--help" ]]; then
   echo "Usage: pgrep PATTERN"
   [[ -z "$1" ]] && exit 1 || exit 0
fi

PATTERN="$1"
FOUND=0

for PROCDIR in /proc/[0-9]*; do
   [[ -r "${PROCDIR}/comm" ]] || continue
   COMM="$(< "${PROCDIR}/comm")"
   if [[ "$COMM" =~ $PATTERN ]]; then
      echo "${PROCDIR##*/}"
      FOUND=1
   fi
done

(( FOUND )) || exit 1

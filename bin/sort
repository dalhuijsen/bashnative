#!/bin/bash
# bashnative/sort - Copyright 2013 Thijs Dalhuijsen <dalhuijsen@gmail.com>
# This program is distributed under the terms of the GNU General Public License
# (GPLv3) as published by the Free Software Foundation.
# <http://www.gnu.org/licenses/> <https://github.com/dalhuijsen/bashnative>

# Bubble sort in bash.  Not fast, but it works.  ;-)
# For the record: bash is NOT the right tool for sorting large files.

RFLAG=0
NFLAG=0
UFLAG=0

main () {
   while [[ "${1:0:1}" == "-" ]]; do
      case "$1" in
         -r) RFLAG=1 ;;
         -n) NFLAG=1 ;;
         -u) UFLAG=1 ;;
         --help|-h) helpmsg; exit 0 ;;
         --) shift; break ;;
         *) break ;;
      esac
      shift
   done

   # slurp all lines into an array
   local -a LINES
   while IFS= read -r LINE; do
      LINES+=("$LINE")
   done < "${1:-/dev/stdin}"

   local LEN=${#LINES[@]}

   # bubble sort -- yes, O(n²), this is bash ;)
   local I=0
   while (( I < LEN )); do
      local J=$(( I + 1 ))
      while (( J < LEN )); do
         local SWAP=0
         if (( NFLAG )); then
            # numeric comparison
            local A="${LINES[$I]%%[!0-9-]*}"
            local B="${LINES[$J]%%[!0-9-]*}"
            A="${A:-0}"
            B="${B:-0}"
            if (( RFLAG )); then
               (( A < B )) && SWAP=1
            else
               (( A > B )) && SWAP=1
            fi
         else
            # lexicographic
            if (( RFLAG )); then
               [[ "${LINES[$I]}" < "${LINES[$J]}" ]] && SWAP=1
            else
               [[ "${LINES[$I]}" > "${LINES[$J]}" ]] && SWAP=1
            fi
         fi

         if (( SWAP )); then
            local TMP="${LINES[$I]}"
            LINES[$I]="${LINES[$J]}"
            LINES[$J]="$TMP"
         fi
         (( J++ ))
      done
      (( I++ ))
   done

   # output (with optional -u dedup)
   local PREV=""
   for LINE in "${LINES[@]}"; do
      if (( UFLAG )) && [[ "$LINE" == "$PREV" ]]; then
         continue
      fi
      echo "$LINE"
      PREV="$LINE"
   done
}

helpmsg () {
echo "Usage: sort [OPTION]... [FILE]
Sort lines of text files.

  -r   reverse the result of comparisons
  -n   compare according to string numerical value
  -u   output only unique lines
  -h   display this help and exit
"
}

main "$@"

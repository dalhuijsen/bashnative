#!/bin/bash
# bashnative/shuf - generate random permutations

main () {
   if [[ "$1" == "--help" ]] || [[ "$1" == "-h" ]]; then
      echo "Usage: shuf [FILE]"
      echo "Write a random permutation of the input lines."
      exit 0
   fi

   # slurp lines
   local -a LINES
   while IFS= read -r LINE; do
      LINES+=("$LINE")
   done < "${1:-/dev/stdin}"

   # Fisher-Yates shuffle using $RANDOM
   local N=${#LINES[@]}
   local I=$N
   while (( I > 1 )); do
      (( I-- ))
      local J=$(( RANDOM % (I + 1) ))
      # swap
      local TMP="${LINES[$I]}"
      LINES[$I]="${LINES[$J]}"
      LINES[$J]="$TMP"
   done

   for LINE in "${LINES[@]}"; do
      echo "$LINE"
   done
}

main "$@"

#!/bin/bash
# bashnative/figlet - display large characters made from ordinary screen characters
# Supports multiple fonts via font files in BASHNATIVE/games/fonts/

BASHNATIVE="${BASHNATIVE:-$(dirname "$0")/..}"
FONTDIR="${BASHNATIVE}/games/fonts"
FONTNAME="standard"

main () {
   while [[ "${1:0:1}" == "-" ]]; do
      case "$1" in
         -f) shift; FONTNAME="$1" ;;
         --list|-l) list_fonts; exit 0 ;;
         --help|-h) helpmsg; exit 0 ;;
         --) shift; break ;;
         *) break ;;
      esac
      shift
   done

   local FONTFILE="${FONTDIR}/${FONTNAME}.font"
   if [[ ! -r "$FONTFILE" ]]; then
      echo "figlet: font '${FONTNAME}' not found" >&2
      echo "Available fonts: $(list_fonts)" >&2
      exit 1
   fi

   local TEXT="${*:-}"
   if [[ -z "$TEXT" ]]; then
      while IFS= read -r LINE; do
         render "$LINE" "$FONTFILE"
      done
   else
      render "$TEXT" "$FONTFILE"
   fi
}

list_fonts () {
   for F in "${FONTDIR}"/*.font; do
      [[ -f "$F" ]] || continue
      local NAME="${F##*/}"
      echo "${NAME%.font}"
   done
}

render () {
   local TEXT="${1^^}"   # bash 4.0+ native uppercase — no tr dependency
   local FONTFILE="$2"
   local HEIGHT=0

   # read font height from first line
   read -r HEIGHT < "$FONTFILE"

   # read character definitions into associative array
   # store each line separately: GLYPHS["A:0"], GLYPHS["A:1"], etc.
   local -A GLYPHS
   local CHAR="" LINENUM=0
   local SKIP=1 HAVE_CHAR=""

   while IFS= read -r LINE; do
      if (( SKIP )); then
         SKIP=0
         continue
      fi
      if [[ -z "$HAVE_CHAR" ]]; then
         # skip blank separator lines between glyphs
         [[ -z "$LINE" ]] && continue
         CHAR="$LINE"
         LINENUM=0
         HAVE_CHAR=1
      else
         GLYPHS["${CHAR}:${LINENUM}"]="$LINE"
         (( LINENUM++ ))
         if (( LINENUM >= HEIGHT )); then
            HAVE_CHAR=""
         fi
      fi
   done < "$FONTFILE"

   # space character: set all rows to empty (width handled by padding)
   local R=0
   while (( R < HEIGHT )); do
      GLYPHS[" :${R}"]="  "
      (( R++ ))
   done

   # find max width per character for proper spacing
   local -A WIDTHS
   local I=0
   while (( I < ${#TEXT} )); do
      local CH="${TEXT:$I:1}"
      local MAXW=0 R=0
      while (( R < HEIGHT )); do
         local W="${#GLYPHS[${CH}:${R}]}"
         (( W > MAXW )) && MAXW=$W
         (( R++ ))
      done
      WIDTHS["$CH"]=$MAXW
      (( I++ ))
   done

   # render text line by line, padding each glyph to its max width
   local ROW=0
   while (( ROW < HEIGHT )); do
      local I=0
      while (( I < ${#TEXT} )); do
         local CH="${TEXT:$I:1}"
         local KEY="${CH}:${ROW}"
         local GLYPH="${GLYPHS[$KEY]:-}"
         local W="${WIDTHS[$CH]:-5}"
         printf "%-${W}s" "$GLYPH"
         (( I++ ))
      done
      echo
      (( ROW++ ))
   done
}

helpmsg () {
echo "Usage: figlet [-f FONT] TEXT
Display large characters made from ordinary screen characters.

  -f FONT    select font (default: standard)
  -l, --list list available fonts
  -h, --help display this help

Available fonts:"
   list_fonts | sed 's/^/  /'
}

main "$@"

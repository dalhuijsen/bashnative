#!/bin/bash
# bashnative/sha1sum - compute SHA1 message digest
# Pure bash SHA1 would be thousands of lines and glacially slow.
# We wrap available system tools, same approach as md5sum.

main () {
   [[ "$1" == "--help" ]] && { echo "Usage: sha1sum [FILE]..."; exit 0; }

   for FILE in "${@:--}"; do
      if type sha1sum >/dev/null 2>&1; then
         command sha1sum "$FILE"
      elif type shasum >/dev/null 2>&1; then
         shasum -a 1 "$FILE"
      elif type openssl >/dev/null 2>&1; then
         local OUT="$(openssl sha1 "$FILE" 2>/dev/null)"
         OUT="${OUT##* }"
         echo "${OUT}  $FILE"
      else
         echo "sha1sum: no sha1 tool available" >&2
         exit 1
      fi
   done
}

main "$@"

#!/bin/bash
# bashnative/comm - compare two sorted files line by line

FLAG1=0
FLAG2=0
FLAG3=0

main () {
   while [[ "${1:0:1}" == "-" ]]; do
      case "$1" in
         -*1*) FLAG1=1 ;;&
         -*2*) FLAG2=1 ;;&
         -*3*) FLAG3=1 ;;&
         --help|-h) echo "Usage: comm [-123] FILE1 FILE2"; exit 0 ;;
      esac
      shift
   done

   if [[ -z "$1" ]] || [[ -z "$2" ]]; then
      echo "comm: missing operand" >&2
      exit 1
   fi

   exec 3<"$1" 4<"$2"
   local EOF1=0 EOF2=0 L1="" L2=""

   IFS= read -r L1 <&3 || EOF1=1
   IFS= read -r L2 <&4 || EOF2=1

   while (( !EOF1 || !EOF2 )); do
      if (( EOF2 )) || { (( !EOF1 )) && [[ "$L1" < "$L2" ]]; }; then
         (( FLAG1 )) || echo "$L1"
         IFS= read -r L1 <&3 || EOF1=1
      elif (( EOF1 )) || [[ "$L1" > "$L2" ]]; then
         (( FLAG2 )) || { (( FLAG1 )) && echo "$L2" || echo "	$L2"; }
         IFS= read -r L2 <&4 || EOF2=1
      else
         if (( !FLAG3 )); then
            local PRE=""
            (( FLAG1 )) || PRE="${PRE}	"
            (( FLAG2 )) || PRE="${PRE}	"
            echo "${PRE}${L1}"
         fi
         IFS= read -r L1 <&3 || EOF1=1
         IFS= read -r L2 <&4 || EOF2=1
      fi
   done

   exec 3<&- 4<&-
}

main "$@"

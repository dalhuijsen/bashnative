# Pure bash sleep using read -t (integer seconds only, no fractions)
# Trick: read with timeout on a fd that will never have data

main () {
   if [[ -z "$1" ]] || [[ "$1" == "--help" ]]; then
      echo "Usage: sleep SECONDS"
      [[ -z "$1" ]] && exit 1 || exit 0
   fi

   local SECS="$1"

   # strip trailing 's' if someone writes "5s"
   SECS="${SECS%s}"

   if [[ ! "$SECS" =~ ^[0-9]+$ ]]; then
      echo "sleep: invalid time interval '$1'" >&2
      exit 1
   fi

   # read -t N will wait N seconds on an empty pipe
   read -t "$SECS" < <(:) 2>/dev/null || true
}

main "$@"

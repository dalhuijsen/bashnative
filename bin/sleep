# Pure bash sleep using read -t (supports fractional seconds in bash 4+)

main () {
   if [[ -z "$1" ]] || [[ "$1" == "--help" ]]; then
      echo "Usage: sleep SECONDS[.FRAC]"
      [[ -z "$1" ]] && exit 1 || exit 0
   fi

   local SECS="$1"
   SECS="${SECS%s}"   # strip trailing 's'

   # read -t with a closed fd — returns 1 after timeout, which is success for us
   read -t "$SECS" -u 3 3</dev/null 2>/dev/null || true
}

main "$@"

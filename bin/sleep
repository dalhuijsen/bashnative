# Uses bash builtin sleep if available, otherwise read -t trick

main () {
   if [[ -z "$1" ]] || [[ "$1" == "--help" ]]; then
      echo "Usage: sleep SECONDS[.FRAC]"
      [[ -z "$1" ]] && exit 1 || exit 0
   fi

   local SECS="$1"
   SECS="${SECS%s}"   # strip trailing 's'

   # try builtin sleep first (supports fractions)
   builtin sleep "$SECS" 2>/dev/null && return 0

   # fallback: read -t (bash supports fractional timeouts)
   read -t "$SECS" <> <(:) 2>/dev/null || true
}

main "$@"

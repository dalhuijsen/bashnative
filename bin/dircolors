#!/bin/bash
# bashnative/dircolors - output shell code to set LS_COLORS
# Since our ls doesn't use LS_COLORS (yet), this just sets a basic value

[[ "$1" == "--help" ]] && { echo "Usage: dircolors"; exit 0; }

if [[ "$1" == "-b" ]] || [[ "$1" == "--sh" ]] || [[ -z "$1" ]]; then
   echo "LS_COLORS='rs=0:di=01;34:ln=01;36:so=01;35:pi=40;33:ex=01;32:bd=40;33;01:cd=40;33;01:su=37;41:sg=30;43:tw=30;42:ow=34;42';"
   echo "export LS_COLORS"
elif [[ "$1" == "-c" ]] || [[ "$1" == "--csh" ]]; then
   echo "setenv LS_COLORS 'rs=0:di=01;34:ln=01;36:so=01;35:pi=40;33:ex=01;32';"
fi

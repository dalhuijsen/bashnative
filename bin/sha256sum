#!/bin/bash
# bashnative/sha256sum - compute SHA256 message digest

main () {
   [[ "$1" == "--help" ]] && { echo "Usage: sha256sum [FILE]..."; exit 0; }

   for FILE in "${@:--}"; do
      if type sha256sum >/dev/null 2>&1; then
         command sha256sum "$FILE"
      elif type shasum >/dev/null 2>&1; then
         shasum -a 256 "$FILE"
      elif type openssl >/dev/null 2>&1; then
         local OUT="$(openssl sha256 "$FILE" 2>/dev/null)"
         OUT="${OUT##* }"
         echo "${OUT}  $FILE"
      else
         echo "sha256sum: no sha256 tool available" >&2
         exit 1
      fi
   done
}

main "$@"

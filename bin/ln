#!/bin/bash
# bashnative/ln - create links between files
# NOTE: bash cannot call link(2) or symlink(2) natively.
# This uses the 'mk' fallback chain or external ln.

BASHNATIVE="${BASHNATIVE:-$(dirname "$0")/..}"

SFLAG=
FFLAG=

main () {
   while [[ "${1:0:1}" == "-" ]]; do
      case "$1" in
         -s|--symbolic) SFLAG=1 ;;
         -f|--force)    FFLAG=1 ;;
         --help|-h)     helpmsg; exit 0 ;;
         --) shift; break ;;
         *)  break ;;
      esac
      shift
   done

   if [[ -z "$1" ]] || [[ -z "$2" ]]; then
      echo "ln: missing operand" >&2
      exit 1
   fi

   TARGET="$1"
   LINKNAME="$2"

   if [[ -n "$FFLAG" ]] && [[ -e "$LINKNAME" ]]; then
      rm -f "$LINKNAME" 2>/dev/null
   fi

   # can't do this in pure bash, need external ln
   if [[ -n "$SFLAG" ]]; then
      command ln -s "$TARGET" "$LINKNAME"
   else
      command ln "$TARGET" "$LINKNAME"
   fi
}

helpmsg () {
echo "Usage: ln [OPTION]... TARGET LINK_NAME
Create a link to TARGET with the name LINK_NAME.

  -s, --symbolic   make symbolic links instead of hard links
  -f, --force      remove existing destination files
  -h, --help       display this help and exit

Note: requires external ln (bash cannot call link/symlink syscalls).
"
}

main "$@"

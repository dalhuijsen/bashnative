#!/bin/bash
# bashnative/unexpand - convert spaces to tabs

TABSTOP=8

if [[ "$1" == "-t" ]]; then
   shift; TABSTOP="$1"; shift
fi

# generate spaces string to match
SPACES=""
I=0
while (( I++ < TABSTOP )); do SPACES="${SPACES} "; done

while IFS= read -r LINE; do
   echo "${LINE//$SPACES/$'\t'}"
done < "${1:-/dev/stdin}"

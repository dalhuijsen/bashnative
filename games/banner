#!/bin/bash
# bashnative/banner - print large ASCII art text
# Classic BSD banner: just figlet with the big font

BASHNATIVE="${BASHNATIVE:-$(dirname "$0")/..}"

main () {
   [[ "$1" == "--help" || "$1" == "-h" ]] && {
      echo "Usage: banner TEXT"
      echo "Print TEXT in large letters."
      exit 0
   }
   "${BASHNATIVE}/bin/figlet" -f big "$@"
}

main "$@"
